# Web MindMap — 環境変数テンプレート
# 実値は .env.local に置く（.gitignore 済み / public リポジトリのため絶対にコミットしない）

# --- Neon PostgreSQL（担当 B / クラウド同期） ---
# Neon コンソール > Connection string（Pooled connection）
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# --- Auth.js（担当 B / 認証） ---
# openssl rand -base64 32 で生成
AUTH_SECRET=""
# 本番は https://<独自ドメイン> を設定（ローカルは未設定で可）
AUTH_URL="http://localhost:3000"

# Google OAuth（Google Cloud Console > 認証情報 > OAuth クライアント ID）
# 承認済みリダイレクト URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# メールログイン（マジックリンク / Resend）
AUTH_RESEND_KEY=""
AUTH_EMAIL_FROM="login@example.com"

# --- 広告（担当 B / task.md §14） ---
# 広告事業者のクライアント ID。未設定なら本番では広告枠を一切描画しない
# （開発時のみレイアウト確認用の仮表示が出る）。
# NEXT_PUBLIC_ 接頭辞のためクライアントに露出する。秘密情報は入れないこと。
NEXT_PUBLIC_AD_CLIENT=""
