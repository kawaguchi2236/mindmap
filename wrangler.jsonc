{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "web-mindmap",
  "main": ".open-next/worker.js",

  // ADR-001: Auth.js / Neon ドライバが Node.js API を使うため nodejs_compat が必須。
  // compatibility_date は 2024-09-23 以降であること（それ以前だと nodejs_compat v2 が効かない）。
  "compatibility_date": "2026-09-13",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  }

  // シークレット（DATABASE_URL / AUTH_SECRET / AUTH_GOOGLE_* など）はここに書かない。
  // ローカルは .dev.vars、本番は `wrangler secret put <NAME>` で設定する。
}
